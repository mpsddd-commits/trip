# trip 환경변수 템플릿 (UD-14)
#
# 사용법:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
#
# 🔴 인증 정보 6개를 제외한 **모든 항목에 기본값이 있습니다.**
#    .env 없이 기동해도 목(mock) 데이터 모드로 전 화면이 동작합니다 (FR-33).
#    비어 있는 API 는 자동으로 목 구현으로 대체되며, /api/health/ready 에서 확인할 수 있습니다.

# =============================================================================
# 인증 정보 — 전부 선택. 비우면 해당 API 만 목 모드 (FR-33, DD-3)
# =============================================================================
# 네이버 개발자센터 (지역검색 / 블로그 / 이미지)  https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 클라우드 플랫폼 (Directions 5 / Geocoding)  https://www.ncloud.com
NCP_CLIENT_ID=
NCP_CLIENT_SECRET=

# ⚠️ 지도 SDK 클라이언트 키는 구조상 브라우저에 노출됩니다 (CON-3).
#    NCP 콘솔에서 **도메인 화이트리스트(Web 서비스 URL)** 를 반드시 등록하세요.
NCP_MAP_CLIENT_KEY=

# Anthropic Claude API  https://console.anthropic.com
ANTHROPIC_API_KEY=

# =============================================================================
# 서버 / 배포
# =============================================================================
# 🔴 BIND_HOST 는 Compose 포트 매핑의 노출 인터페이스를 결정합니다 (ID-11, CA-1).
#    127.0.0.1 : 이 PC 의 브라우저만 접근 (기본, 권장)
#    0.0.0.0   : 같은 네트워크의 모든 기기가 접근 — 안드로이드 실기기 연동 시에만
#                ⚠️ 인증이 없는 구성이므로 공용 Wi-Fi 에서는 절대 사용하지 마세요.
#                ⚠️ 기동 로그에 WARN 이 출력됩니다. 연동이 끝나면 되돌리세요.
BIND_HOST=127.0.0.1
PORT=8200
TZ=Asia/Seoul

# 개발 모드에서 Vite dev 서버를 쓸 때만 지정 (ND-12).
# 와일드카드(*)는 어떤 값을 넣어도 무시됩니다 (SEC-08).
CORS_ALLOW_ORIGINS=

DATABASE_PATH=/app/data/trip.db
LOG_DIR=/app/logs
STATIC_DIR=/app/static
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Seoul

# =============================================================================
# 복원력 (RP-1, RP-2 / BR-47)
# =============================================================================
HTTP_CONNECT_TIMEOUT_SEC=5
HTTP_READ_TIMEOUT_SEC=10
LLM_READ_TIMEOUT_SEC=120
HTTP_MAX_RETRIES=3
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=60

# =============================================================================
# 동시성 (SP-3 / ND-3, ND-17, ND-18)
# =============================================================================
MAX_CONCURRENT_JOBS=3
JOB_PARALLELISM=5
# API 별 전역 동시 호출 상한. job 동시성과 곱해지지 않도록 하는 안전장치 (ND-17)
EXTERNAL_CONCURRENCY=5
DB_THREAD_POOL_SIZE=8

# =============================================================================
# 레이트 리밋 / 쿼터 (BR-49, BR-50 / CA-5 비용 남용 차단)
# =============================================================================
RATE_EXPENSIVE_PER_HOUR=5
RATE_EXPENSIVE_GLOBAL_PER_DAY=50
RATE_EXTERNAL_PER_MIN=60
RATE_CHEAP_PER_MIN=300
QUOTA_NAVER_LOCAL_PER_DAY=25000

# =============================================================================
# 캐시 / 수명 (BR-48, BR-56, BR-57, BR-59)
# =============================================================================
CACHE_TTL_LOCAL_SEARCH_DAYS=7
CACHE_TTL_DIRECTIONS_DAYS=1
CACHE_TTL_CONTENT_DAYS=3
CACHE_TTL_GEOCODE_DAYS=30
CACHE_GRACE_DAYS=7
JOB_RETENTION_HOURS=24
AUDIT_RETENTION_DAYS=90

# =============================================================================
# 도메인 규칙 (BR-01 ~ BR-26, BR-52)
# =============================================================================
# 항목 수 = 그라운딩 검색 호출 수 = 비용. 이 값이 곧 비용 상한입니다 (BR-02).
MAX_TRIP_DAYS=10
MAX_ITEMS_PER_DAY=15
MAX_ITEMS_PER_TRIP=100
MAX_REQUEST_BODY_BYTES=1048576

LLM_MODEL=claude-sonnet-5
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8000

# 🔴 그라운딩 일치 판정 임계값 (BR-11 ①).
#    낮추면 엉뚱한 장소가 일정에 들어올 위험이, 높이면 "확인 필요"가 늘어납니다.
RESOLVE_SIMILARITY_THRESHOLD=0.60

# 이동시간 근사 (BR-24 ~ BR-26). 대중교통은 네이버가 API 를 제공하지 않아 추정치입니다 (CON-1).
WALK_DETOUR=1.3
WALK_SPEED_KMH=4.5
WALK_MIN_SEC=180
TRANSIT_DETOUR=1.4
TRANSIT_SPEED_KMH=20
TRANSIT_WAIT_SEC=600
TRANSIT_MIN_SEC=600
CAR_FALLBACK_DETOUR=1.4
CAR_FALLBACK_SPEED_KMH=30
CAR_MIN_SEC=300

# 순서 최적화 종료 조건 3중 (BR-22)
OPTIMIZE_NO_IMPROVE_LIMIT=50
OPTIMIZE_MAX_ITER=1000
OPTIMIZE_TIME_LIMIT_MS=200
